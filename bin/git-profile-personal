#!/usr/bin/env fish

# Switch to personal git profile (updates remotes to use personal SSH key)
# Identity comes from environment or interactive prompt; never hardcoded.
# Required: GIT_PERSONAL_NAME, GIT_PERSONAL_EMAIL

if not set -q GIT_PERSONAL_NAME
	# Shebang scripts are never "interactive" for `status is-interactive`,
	# so just attempt the prompt: `read` succeeds on a terminal or a pipe
	# and fails when stdin is closed (/dev/null).
	read -P "Personal git user.name: " GIT_PERSONAL_NAME
	or begin
		echo "GIT_PERSONAL_NAME is not set" >&2
		exit 1
	end
end
if test -z "$GIT_PERSONAL_NAME"
	echo "GIT_PERSONAL_NAME must not be empty" >&2
	exit 1
end
if not set -q GIT_PERSONAL_EMAIL
	read -P "Personal git user.email: " GIT_PERSONAL_EMAIL
	or begin
		echo "GIT_PERSONAL_EMAIL is not set" >&2
		exit 1
	end
end
if test -z "$GIT_PERSONAL_EMAIL"
	echo "GIT_PERSONAL_EMAIL must not be empty" >&2
	exit 1
end

git config --local user.name "$GIT_PERSONAL_NAME"
git config --local user.email "$GIT_PERSONAL_EMAIL"

# Update existing remotes to use personal SSH key (github-personal)
for remote in (git remote)
	set remote_url (git remote get-url $remote)
	
	# Handle SSH URLs: git@github.com:user/repo -> git@github-personal:user/repo
	if string match -q "git@github.com:*" $remote_url
		set new_url (string replace "git@github.com:" "git@github-personal:" $remote_url)
		git remote set-url $remote $new_url
		echo "Updated remote '$remote': $new_url"
	# Handle HTTPS URLs: https://github.com/user/repo -> git@github-personal:user/repo
	else if string match -q "https://github.com/*" $remote_url
		set repo_path (string replace "https://github.com/" "" $remote_url)
		set new_url "git@github-personal:$repo_path"
		git remote set-url $remote $new_url
		echo "Updated remote '$remote': $new_url (converted HTTPS to SSH)"
	# Skip if already using github-personal
	else if string match -q "*github-personal*" $remote_url
		echo "Remote '$remote' already uses github-personal"
	end
end

echo "Switched to personal git profile: $GIT_PERSONAL_NAME <$GIT_PERSONAL_EMAIL>"
