# vi: ft=sshconfig
# Host aliases below select which key/identity git uses (git@github-work:...).
# Keys themselves live in ~/.ssh/ and are NOT committed. Add/rotate a key with:
#   add-github-profile work|personal <name> <email>   (see README "SSH keys / GitHub")

Host *
	ServerAliveInterval 60
	CanonicalizeHostName yes
	CanonicalizeFallbackLocal yes
	CanonicalDomains local

Host localhost
	UserKnownHostsFile /dev/null
	StrictHostKeyChecking no

# Personal GitHub profile (stvmachine)
Host github-personal
	HostName github.com
	User git
	AddKeysToAgent yes
	UseKeychain yes
	IdentityFile ~/.ssh/id_ed25519
	IdentitiesOnly yes

# Work GitHub profile
Host github-work
	HostName github.com
	User git
	AddKeysToAgent yes
	UseKeychain yes
	IdentityFile ~/.ssh/id_work_ed25519
	IdentitiesOnly yes
